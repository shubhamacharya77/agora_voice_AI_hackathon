# Copy to .env and fill in. Never commit .env; never paste its values into chat.
# Setup steps for every key: see the "CoO Setup Checklist" doc.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (local Docker container from docker-compose.yml, host port 5433) ---
DATABASE_URL=postgresql+psycopg://coo:coo@localhost:5433/coo

# --- Auth ---
# Long random string (32+ characters) used to sign login tokens.
JWT_SECRET=
# Login tokens last this many minutes (default 720 = 12 hours).
# ACCESS_TOKEN_TTL_MINUTES=720
# Browser origins allowed to call the API (JSON list). Default: the Vite dev server.
# CORS_ORIGINS=["http://localhost:5173"]

# One-click demo logins for the seeded demo admin and employee (no password).
# Keep this false anywhere real.
DEMO_LOGIN_ENABLED=true
# Optional passwords so the demo users can also log in with email + password.
# Leave empty and only one-click demo login works for them.
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=

# --- AI model ---
# groq      -> LLM_MODEL=openai/gpt-oss-120b (or openai/gpt-oss-20b), key in GROQ_API_KEY
# anthropic -> LLM_MODEL=claude-haiku-5-5, key in ANTHROPIC_API_KEY
# bedrock   -> LLM_MODEL=anthropic.claude-haiku-5-5, AWS profile or Bedrock API key below
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
# Either an AWS CLI profile (from `aws configure`)...
AWS_PROFILE=default
# ...or a Bedrock API key instead of the profile.
AWS_BEARER_TOKEN_BEDROCK=
# "low" answers fastest; "medium" or "high" think more (default low).
# LLM_EFFORT=low
# Model calls allowed per turn, tool rounds included (default 5).
# AGENT_MAX_STEPS=5

# --- Agora (Conversational AI Engine) ---
# Required for voice: App ID and App Certificate (Console -> project -> Manage credentials).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional: RESTful API Customer ID/Secret. Without them, a token made from the App ID
# and App Certificate authenticates Agora's REST API instead.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Speech recognition language for Agora's ASR (default en-US).
# AGORA_ASR_LANGUAGE=en-US

# --- Murf (voice used by Agora) ---
MURF_API_KEY=
MURF_VOICE_ID=en-IN-isha
# Murf model and locale passed to Agora. falcon-2.1 is current (FALCON still maps to it).
# MURF_MODEL=falcon-2.1
# MURF_LOCALE=en-IN   (en-IN voices: en-IN-isha, en-IN-aarav, en-IN-priya, ...)

# --- Gmail (one admin mailbox) ---
# OAuth client of type "Desktop app" (Google Cloud console -> Google Auth platform -> Clients).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Written by the one-time sign-in:  cd backend && uv run python -m app.mail.connect
# Never paste the token anywhere else. There is no demo inbox: until this is set, CoO
# says Gmail isn't connected.
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=
# Who "email Akshay" means. Names not listed are looked up among people the mailbox
# has emailed with. Example: Akshay Rao <akshay@example.com>, Priya Nair <priya@example.com>
MAIL_CONTACTS=

# --- Web search and news (live, https://app.tavily.com) ---
TAVILY_API_KEY=

# --- Tunnel and Agora -> backend ---
# The public ngrok URL for the backend.
PUBLIC_BASE_URL=
# Random secret that Agora sends to our custom-LLM endpoint.
CUSTOM_LLM_API_KEY=
